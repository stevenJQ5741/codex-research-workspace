{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scoped Theory Context v0.2.2",
  "type": "object",
  "required": [
    "schema_version", "project_id", "research_question", "theory_cards",
    "material_system", "model_assumptions", "boundary_conditions", "parameters",
    "applicability", "conflicts", "unresolved_issues", "generated_at",
    "reviewed_at", "reviewed_by", "review_record", "reuse_conditions", "invalidation_conditions"
  ],
  "properties": {
    "schema_version": {"const": "0.2.2"},
    "example_only": {"type": "boolean"},
    "project_id": {"type": "string", "minLength": 1},
    "research_question": {"type": "string", "minLength": 1},
    "theory_cards": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path", "card_sha256", "index_record_sha256", "review_status", "source_claims_checked"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "card_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "index_record_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "review_status": {"enum": ["candidate", "reviewed", "disputed", "retired"]},
          "source_claims_checked": {"type": "boolean"}
        }
      }
    },
    "material_system": {"type": "string", "minLength": 1},
    "model_assumptions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "boundary_conditions": {"type": "object"},
    "parameters": {"type": "object"},
    "applicability": {
      "type": "object", "required": ["status", "scope", "limitations"],
      "properties": {
        "status": {"enum": ["applicable", "conditional", "unresolved", "blocked"]},
        "scope": {"type": "string", "minLength": 1},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "conflicts": {"type": "array", "items": {"type": "string"}},
    "unresolved_issues": {
      "type": "array",
      "items": {
        "type": "object", "required": ["issue", "blocking"],
        "properties": {"issue": {"type": "string"}, "blocking": {"type": "boolean"}}
      }
    },
    "generated_at": {"type": "string", "format": "date-time"},
    "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
    "reviewed_by": {"type": ["string", "null"], "minLength": 1},
    "review_record": {
      "type": ["object", "null"],
      "required": ["decision", "basis_refs", "limitations_checked", "conflicts_checked"],
      "properties": {
        "decision": {"enum": ["scope_reviewed", "pending"]},
        "basis_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "limitations_checked": {"type": "boolean"},
        "conflicts_checked": {"type": "boolean"}
      }
    },
    "reuse_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "invalidation_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "knowledge_base_commit": {"type": ["string", "null"]}
  }
}
